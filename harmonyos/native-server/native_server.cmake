# Generic OHOS helper. Include during the root project and defer until server exists.
include_guard(GLOBAL)
if(NOT CMAKE_SYSTEM_NAME STREQUAL "OHOS")
    message(FATAL_ERROR "native llama-server child requires OHOS")
endif()
if(NOT CMAKE_POSITION_INDEPENDENT_CODE OR BUILD_SHARED_LIBS)
    message(FATAL_ERROR "Use PIC static dependencies: CMAKE_POSITION_INDEPENDENT_CODE=ON, BUILD_SHARED_LIBS=OFF")
endif()
set(PICO_NATIVE_SERVER_ENTRY "${CMAKE_CURRENT_LIST_DIR}/entry.cpp")
function(pico_add_native_server)
    if(NOT TARGET llama-server-impl)
        message(FATAL_ERROR "Pinned llama-server-impl target is required")
    endif()
    add_library(llama-server-child SHARED "${PICO_NATIVE_SERVER_ENTRY}")
    target_compile_features(llama-server-child PRIVATE cxx_std_17)
    target_include_directories(llama-server-child PRIVATE "${PROJECT_SOURCE_DIR}/vendor")
    target_link_libraries(llama-server-child PRIVATE llama-server-impl)
    target_link_options(llama-server-child PRIVATE "LINKER:--no-undefined" "LINKER:--exclude-libs,ALL")
    set_target_properties(llama-server-child PROPERTIES CXX_VISIBILITY_PRESET hidden
        VISIBILITY_INLINES_HIDDEN ON)
endfunction()
cmake_language(DEFER DIRECTORY "${CMAKE_SOURCE_DIR}" CALL pico_add_native_server)
